<%layout("/layouts/boilerplate") %>
<div class="row mt-2">
      <div class="col-8 offset-2">
        <br><br>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

      <div class="md-3">
        <label for="title" class="form-label">Title</label>
      <input name="listing[title]" placeholder="Add a catchy title" type="text" required class="form-control"/>
      <div class="valid-feedback">Title looks good..</div>
      </div>

      <div class="md-3">
        <label for="description" class="form-label">Description</label>
      <textarea name="listing[description]" class="form-control" required> </textarea>
      <div class="invalid-feedback">please enter short description.</div>
      </div>

      <!-- <div class="md-3">
        <label for="image" class="form-label">Image link</label>
      <input name="listing[image][url]" placeholder="enter image URL/Link" type="text" class="form-control"/>
      </div> -->

      <div class="md-3">
        <label for="image" class="form-label">Upload new image</label>
      <input name="listing[image]" type="file" class="form-control"/>
      </div>

      <div class="row">
      <div class="md-3 col-md-4">
        <label for="price" class="form-label">price</label>
      <input name="listing[price]" placeholder="1200" type="number" required class="form-control"  />
      <div class="invalid-feedback">please enter valid price..</div>
      </div>

      <div class="md-3 col-md-8">
      <label for="country" class="form-label">country</label>
      <input name="listing[country]" placeholder="India" type="text" required class="form-control" />
      <div class="invalid-feedback">please enter valid country name..</div>
      </div>
       </div>

      <div class="md-3">
        <label for="location" class="form-label">location</label>
      <input name="listing[location]" placeholder="Ranchi" type="text" required class="form-control" required/>
      <div class="invalid-feedback">please enter valid location.</div>
      </div>

      <button class="btn btn-dark add-btn mt-3">Add</button>
    </form>
    </div>
  </div>